DirectoryIndex index.html
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

# Git metadata must never be served from a cPanel checkout.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(?:/|$) - [F,L]
</IfModule>

# PDF.js modules and optional decoders are served directly, without a build step.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType application/wasm .wasm
  AddType application/pdf .pdf
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>

# Keep authoring records and development utilities outside the public interface.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(?:\.qa|tools|tests|maintenance|work)(?:/|$) - [F,L]
  RewriteRule (^|/)(?:SOURCE_MANIFEST|QUESTION_REFERENCE_AUDIT|STUDY_NOTE_ANSWER_REVIEW|STUDY_NOTE_SUPPORT|STUDY_NOTE_SUPPORT_AUDIT|ANSWER_COMPLETENESS_AUDIT|VERIFICATION|PUBLIC_READER_COPY|PUBLIC_COPY_AUDIT|Outline_Coverage_Audit)\.json$ - [F,L]
  RewriteRule ^(?:README|DEPLOYMENT)\.md$ - [F,L]
  RewriteRule ^Modules/catalog\.json$ - [F,L]
  RewriteRule ^ANSWER_REVIEW_SUMMARY\.html$ - [F,L]
</IfModule>

# Private PDF build reports and font sources are not public download assets.
<IfModule mod_rewrite.c>
  RewriteRule ^assets/(?:pdf/(?:qa|fonts)|export-data)(?:/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
